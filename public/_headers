/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=()

/assets/*
  Cache-Control: public, max-age=31536000, immutable

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

# Art is replaced in place under stable filenames. A 7-day max-age left the
# custom-domain edge serving old location Real Photo files after a redeploy.
# Revalidate daily so the next in-place swap cannot sit for a week.
/stickers/*
  Cache-Control: public, max-age=86400, must-revalidate

# pages.dev copies (the production alias and preview deploys) stay out of search;
# naturestickers.shop itself is not matched here and stays indexable.
https://naturestickers.pages.dev/*
  X-Robots-Tag: noindex
https://:alias.naturestickers.pages.dev/*
  X-Robots-Tag: noindex
